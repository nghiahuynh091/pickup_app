{
  "expo": {
    "name": "nghia_first_mobile_app",
    "slug": "nghia_first_mobile_app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nghiaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.expo.nghia-first-mobile-app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses location to show your position during hangouts with friends.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to show your position during hangouts with friends.",
        "NSLocationAlwaysUsageDescription": "This app uses location to track your position and share it with friends during hangouts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.expo.nghia_first_mobile_app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show your position during hangouts with friends.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show your position during hangouts with friends."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        { 
          "image": "./assets/images/emoji4.png",
          "color": "#ffffff"
          
        }

      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d76679a9-e608-4e8d-851e-0ec9d8f6d949"
      }
    },
    "owner": "nghiahuynh091"
  }
}
